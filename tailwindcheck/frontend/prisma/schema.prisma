generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactSubmission {
  id              Int      @id @default(autoincrement())
  name            String
  contactno       String
  appointmentDate DateTime
  message         String?
  createdAt       DateTime @default(now())
}
